// Title: High-volume upload to public file-sharing services
// Severity: Medium | ATT&CK: T1567.002 Exfiltration to Cloud Storage
// Data: DeviceNetworkEvents (Defender for Endpoint)
// Tune: Maintain an organizational allowlist and adjust the connection threshold for browser-heavy environments.
let fileSharingDomains = dynamic(["mega.nz", "dropbox.com", "drive.google.com", "wetransfer.com", "transfer.sh", "file.io", "sendspace.com", "gofile.io", "anonfiles.com"]);
DeviceNetworkEvents
| where Timestamp > ago(1d) and ActionType == "ConnectionSuccess"
| where RemoteUrl has_any (fileSharingDomains)
| summarize Connections=count(), FirstSeen=min(Timestamp), LastSeen=max(Timestamp), Domains=make_set(RemoteUrl, 20), RemoteIPs=make_set(RemoteIP, 20) by DeviceId, DeviceName, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, bin(Timestamp, 15m)
| where Connections >= 20
| project Timestamp, DeviceName, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, Connections, FirstSeen, LastSeen, Domains, RemoteIPs
| order by Connections desc
