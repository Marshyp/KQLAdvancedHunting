// Title: Rclone exfiltration detection pack
// Severity: High
// ATT&CK: T1567.002
// Data: DeviceProcessEvents, DeviceFileEvents, DeviceNetworkEvents
// Tune: Allowlist approved backup jobs by hash and command line.
let proc = DeviceProcessEvents
| where Timestamp>ago(1d) and (FileName =~ "rclone.exe" or ProcessCommandLine has "rclone")
| where ProcessCommandLine has_any (" copy "," sync "," move "," mega:"," dropbox:"," s3:"," onedrive:"," --config","--transfers")
| project ProcTime=Timestamp,DeviceId,DeviceName,AccountName,ProcessId,ProcessCommandLine,SHA1;
proc
| join kind=leftouter (DeviceNetworkEvents
| where Timestamp>ago(1d) and ActionType=="ConnectionSuccess"
| project NetTime=Timestamp,DeviceId,InitiatingProcessId,RemoteUrl,RemoteIP) on DeviceId
| where isempty(NetTime) or (InitiatingProcessId==ProcessId and NetTime between (ProcTime..ProcTime+2h))
| project ProcTime,NetTime,DeviceName,AccountName,ProcessCommandLine,RemoteUrl,RemoteIP,SHA1
