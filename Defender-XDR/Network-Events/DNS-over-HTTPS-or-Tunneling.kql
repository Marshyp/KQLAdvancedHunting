// Title: Suspicious DNS-over-HTTPS or DNS tunneling utility execution
// Severity: Medium | ATT&CK: T1071.004 DNS
// Data: DeviceProcessEvents
// Tune: Allowlist approved privacy clients, browsers, and network diagnostics.
let tools = dynamic(["dns2tcp","dnscat","iodine","dnscrypt-proxy","cloudflared","doh-client"]);
DeviceProcessEvents
| where Timestamp > ago(1d)
| where ProcessCommandLine has_any (tools)
    or (FileName in~ ("curl.exe","powershell.exe","pwsh.exe") and ProcessCommandLine has_any ("dns-query", "application/dns-message", "resolve?name=", "doh"))
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessCommandLine, SHA1
