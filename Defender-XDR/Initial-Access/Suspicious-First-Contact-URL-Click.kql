// Title: First-contact email followed by an allowed URL click
// Severity: Medium
// ATT&CK: T1566.002 Phishing: Spearphishing Link
// Data: EmailEvents, UrlClickEvents (Defender for Office 365)
// Description: Finds first-contact inbound mail followed by a user click that was not blocked.
// Tune: Allowlist trusted bulk senders and sanctioned marketing domains.
let lookback = 1d;
let suspiciousMail = EmailEvents
| where Timestamp > ago(lookback)
| where EmailDirection == "Inbound" and IsFirstContact == 1 and UrlCount > 0
| where DeliveryAction in~ ("Delivered", "Junked")
| project MailTime=Timestamp, NetworkMessageId, RecipientEmailAddress, SenderFromAddress, SenderFromDomain, Subject, ThreatTypes;
suspiciousMail
| join kind=inner (UrlClickEvents

| where Timestamp > ago(lookback)

| where ActionType !in~ ("ClickBlocked", "UrlErrorPage")

| project ClickTime=Timestamp, NetworkMessageId, AccountUpn, Url, ClickAction=ActionType, IsClickedThrough) on NetworkMessageId
| where ClickTime between (MailTime .. MailTime + 24h)
| project ClickTime, RecipientEmailAddress, AccountUpn, SenderFromAddress, SenderFromDomain, Subject, Url, ClickAction, IsClickedThrough, ThreatTypes, NetworkMessageId
| order by ClickTime desc
