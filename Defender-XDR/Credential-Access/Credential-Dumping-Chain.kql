// Title: Credential dumping followed by lateral authentication
// Severity: High | ATT&CK: T1003.001, T1021
// Data: DeviceProcessEvents, DeviceLogonEvents, DeviceNetworkEvents | Tune: Exclude sanctioned diagnostics and management servers.
let dump=DeviceProcessEvents | where Timestamp>ago(1d) and ProcessCommandLine has_any ("lsass.exe","sekurlsa","comsvcs.dll","MiniDump","ntds.dit","reg save hklm\\sam") | project DumpTime=Timestamp,DeviceId,DeviceName,AccountName,DumpCommand=ProcessCommandLine;
let auth=DeviceLogonEvents | where Timestamp>ago(1d) and ActionType=="LogonSuccess" and LogonType in~ ("Network","RemoteInteractive") | project AuthTime=Timestamp,DeviceId,RemoteDevice=DeviceName,AccountName,RemoteIP,LogonType;
dump | join kind=inner auth on AccountName | where AuthTime between (DumpTime..DumpTime+2h) and DeviceId!=DeviceId1 | project AuthTime,DumpTime,SourceDevice=DeviceName,RemoteDevice,AccountName,RemoteIP,LogonType,DumpCommand
