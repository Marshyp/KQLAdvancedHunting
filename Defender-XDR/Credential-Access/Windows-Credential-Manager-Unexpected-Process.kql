// Title: Windows Credential Manager or Vault access by unexpected process
// Severity: High
// ATT&CK: T1555.004 Windows Credential Manager
// Data: DeviceFileEvents, DeviceRegistryEvents, DeviceProcessEvents
// Tune: Allowlist Windows and enterprise credential-management binaries.
let expected = dynamic(["lsass.exe","svchost.exe","vaultcmd.exe","credentialuibroker.exe","rundll32.exe"]);
union (DeviceFileEvents
| where Timestamp>ago(1d) and FolderPath has_any ("\\Microsoft\\Credentials\\","\\Microsoft\\Vault\\")
| project Timestamp,DeviceName,Account=InitiatingProcessAccountName,Artifact=FolderPath,ActionType,Process=InitiatingProcessFileName,Command=InitiatingProcessCommandLine),(DeviceRegistryEvents
| where Timestamp>ago(1d) and RegistryKey has_any ("\\Microsoft\\Vault","\\Microsoft\\Credentials")
| project Timestamp,DeviceName,Account=InitiatingProcessAccountName,Artifact=RegistryKey,ActionType,Process=InitiatingProcessFileName,Command=InitiatingProcessCommandLine),(DeviceProcessEvents
| where Timestamp>ago(1d) and ProcessCommandLine has_any ("vaultcmd /listcreds","cmdkey /list","CredEnumerate")
| project Timestamp,DeviceName,Account=AccountName,Artifact=ProcessCommandLine,ActionType,Process=FileName,Command=ProcessCommandLine)
| where Process !in~ (expected)
| order by Timestamp desc
