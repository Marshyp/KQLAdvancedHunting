// Title: Browser credential store access by an unusual process
// Severity: High | ATT&CK: T1555.003 Credentials from Web Browsers
// Data: DeviceFileEvents (Defender for Endpoint)
// Description: Detects non-browser processes accessing Chromium or Firefox credential databases.
// Tune: Allowlist approved EDR, backup, password migration, and enterprise browser-management tools by signer and hash.
let browserProcesses = dynamic(["chrome.exe","msedge.exe","brave.exe","firefox.exe","opera.exe"]);
DeviceFileEvents
| where Timestamp > ago(1d)
| where FileName in~ ("Login Data", "logins.json", "key4.db", "Cookies", "Web Data")
| where FolderPath has_any ("\\Google\\Chrome\\User Data\\", "\\Microsoft\\Edge\\User Data\\", "\\BraveSoftware\\Brave-Browser\\User Data\\", "\\Mozilla\\Firefox\\Profiles\\")
| where InitiatingProcessFileName !in~ (browserProcesses)
| project Timestamp, DeviceName, InitiatingProcessAccountName, FileName, FolderPath, ActionType, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessSHA1
| order by Timestamp desc
