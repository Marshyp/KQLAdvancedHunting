// Title: Security product exclusion abuse with suspicious follow-on activity
// Severity: High | ATT&CK: T1562.001
// Data: DeviceProcessEvents, DeviceFileEvents | Tune: Allowlist approved security management and deployment paths.
let exclusions=DeviceProcessEvents | where Timestamp>ago(1d) and ProcessCommandLine has_any ("Add-MpPreference","Set-MpPreference") and ProcessCommandLine has_any ("ExclusionPath","ExclusionProcess","ExclusionExtension") | extend Excluded=extract(@"(?i)-Exclusion(?:Path|Process|Extension)\s+['\"]?([^'\"\s]+)",1,ProcessCommandLine) | where Excluded has_any ("\\Users\\","\\ProgramData\\","\\Temp\\","\\AppData\\") | project ExclusionTime=Timestamp,DeviceId,DeviceName,AccountName,Excluded,ExclusionCommand=ProcessCommandLine;
exclusions | join kind=inner (DeviceFileEvents | where Timestamp>ago(1d) and ActionType=="FileCreated" | project FileTime=Timestamp,DeviceId,FileName,FolderPath,SHA1,Creator=InitiatingProcessFileName) on DeviceId | where FileTime between (ExclusionTime..ExclusionTime+2h) and FolderPath startswith Excluded | project FileTime,ExclusionTime,DeviceName,AccountName,Excluded,ExclusionCommand,FileName,FolderPath,SHA1,Creator
