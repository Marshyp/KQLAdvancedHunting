// Title: Authentication method added before account takeover indicators
// Severity: High
// ATT&CK: T1098.005 Device Registration
// Data: AuditLogs, SigninLogs
// Tune: Exclude approved helpdesk enrollment workflows.
let methods = AuditLogs
| where TimeGenerated > ago(1d) and Result =~ "success" and OperationName has_any ("authentication method","security info","Register security information")
| mv-expand TargetResources
| extend TargetUPN=tostring(TargetResources.userPrincipalName),Actor=tostring(InitiatedBy.user.userPrincipalName)
| where isnotempty(TargetUPN)
| project MethodTime=TimeGenerated,TargetUPN,Actor,MethodOperation=OperationName;
let baseline = SigninLogs
| where TimeGenerated between (ago(30d)..ago(1d)) and ResultType==0
| summarize KnownIPs=make_set(IPAddress,500),KnownCountries=make_set(tostring(LocationDetails.countryOrRegion),100),KnownDevices=make_set(tostring(DeviceDetail.deviceId),500) by UserPrincipalName;
SigninLogs
| where TimeGenerated > ago(1d) and ResultType==0
| extend Country=tostring(LocationDetails.countryOrRegion),DeviceId=tostring(DeviceDetail.deviceId)
| join kind=inner methods on $left.UserPrincipalName==$right.TargetUPN
| join kind=leftouter baseline on UserPrincipalName
| where TimeGenerated between (MethodTime..MethodTime+24h) and (not(set_has_element(KnownIPs,IPAddress)) or not(set_has_element(KnownCountries,Country)) or (isnotempty(DeviceId) and not(set_has_element(KnownDevices,DeviceId))))
| project TimeGenerated,MethodTime,UserPrincipalName,Actor,MethodOperation,IPAddress,Country,DeviceId,AppDisplayName,RiskLevelDuringSignIn
