// Title: Sensitive data interaction followed by an exfiltration channel
// Severity: High | ATT&CK: T1020, T1052.001, T1567.002
// Data: DataSecurityEvents, DeviceEvents, DeviceNetworkEvents, DeviceFileEvents, CloudAppEvents
// Tune: Adjust sensitivity labels, external-sharing semantics, and the 60-minute correlation window.
let sensitive=DataSecurityEvents | where Timestamp>ago(1d) and (isnotempty(SensitivityLabel) or isnotempty(SensitiveInfoTypeInfo)) | project SensitiveTime=Timestamp,Account=tolower(AccountUpn),DeviceId,ObjectName,SensitivityLabel,ActionType;
let channels=union (DeviceEvents | where Timestamp>ago(1d) and ActionType has "UsbDriveMount" | project ChannelTime=Timestamp,Account=tolower(InitiatingProcessAccountUpn),DeviceId,Channel="USB",Evidence=ActionType),(DeviceNetworkEvents | where Timestamp>ago(1d) and RemoteUrl has_any ("mega.nz","dropbox.com","wetransfer.com","file.io","gofile.io") | project ChannelTime=Timestamp,Account=tolower(InitiatingProcessAccountUpn),DeviceId,Channel="File-sharing site",Evidence=RemoteUrl),(DeviceFileEvents | where Timestamp>ago(1d) and FileName matches regex @"(?i)\.(zip|7z|rar|tar|gz)$" | project ChannelTime=Timestamp,Account=tolower(InitiatingProcessAccountUpn),DeviceId,Channel="Archive creation",Evidence=FolderPath),(CloudAppEvents | where Timestamp>ago(1d) and ActionType has "Share" and tostring(RawEventData) has_any ("external","anonymous","Anyone") | project ChannelTime=Timestamp,Account=tolower(AccountId),DeviceId="",Channel="External sharing",Evidence=ObjectName);
sensitive | join kind=inner channels on Account | where ChannelTime between (SensitiveTime..SensitiveTime+60m) and (isempty(DeviceId1) or isempty(DeviceId) or DeviceId==DeviceId1) | project ChannelTime,SensitiveTime,Account,DeviceId,ObjectName,SensitivityLabel,SensitiveAction=ActionType,Channel,Evidence
