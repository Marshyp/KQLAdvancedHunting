// Title: LSASS credential dumping indicators
// Severity: High | ATT&CK: T1003.001 OS Credential Dumping: LSASS Memory
// Data: DeviceProcessEvents
// Tune: Validate backup, EDR, and diagnostic products; allowlist by hash/signer, not filename alone.
DeviceProcessEvents
| where Timestamp > ago(1d)
| where ProcessCommandLine has_any ("lsass.exe", "comsvcs.dll", "MiniDump", "sekurlsa", "procdump")
| where FileName in~ ("rundll32.exe","procdump.exe","procdump64.exe","powershell.exe","pwsh.exe","cmd.exe","taskmgr.exe")
| where ProcessCommandLine has_any ("-ma", "MiniDump", "sekurlsa", "lsass.dmp", "comsvcs.dll")
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, ProcessIntegrityLevel, InitiatingProcessFileName, InitiatingProcessCommandLine, SHA1
